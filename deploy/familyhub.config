# =============================================================================
# FamilyHub Pro: deployment and app configuration
# -----------------------------------------------------------------------------
# One file for everything that is not a secret. Edit, then run:
#   Windows (cmd):  powershell -ExecutionPolicy Bypass -File deploy\deploy.ps1
#   macOS/Linux:    ./deploy/deploy.sh
# Secrets (OAuth client secrets, SMTP password) go in deploy/secrets.env
# (copy deploy/secrets.example.env; that file is git-ignored).
# Format: KEY=VALUE, one per line. Lines starting with # are comments.
# =============================================================================

# ---- Naming --------------------------------------------------------------------
# Prefix for every AWS resource (<name>-server, <name>-db, <name>-web-sg, ...).
PROJECT_NAME=familyhub

# ---- AWS -----------------------------------------------------------------------
# Uses the AWS CLI credentials already configured on this computer (aws configure).
AWS_REGION=us-east-1
# Optional named profile from ~/.aws/credentials. Leave empty for the default.
AWS_PROFILE=
# Availability zone for the server (must be in AWS_REGION).
AWS_AZ=us-east-1a

# ---- Server (EC2) ----------------------------------------------------------------
# t3.small (2 GB) is the minimum that comfortably builds and runs the stack.
EC2_INSTANCE_TYPE=t3.small
EC2_VOLUME_GB=30
# Who may SSH to the server. "auto" = only your current public IP.
SSH_ALLOWED_CIDR=auto

# ---- Database (RDS PostgreSQL) ---------------------------------------------------
DB_ENGINE_VERSION=16
DB_INSTANCE_CLASS=db.t4g.micro
DB_STORAGE_GB=20
# Free-tier accounts are limited to 1 day. Use 7+ after upgrading the AWS plan.
DB_BACKUP_DAYS=1
DB_NAME=familyhub
DB_USER=familyhub

# ---- Web address ---------------------------------------------------------------
# Leave empty to use a free <ip>.sslip.io address with automatic HTTPS.
# For your own domain, point an A record at the server IP first, then set it here.
DOMAIN=

# ---- Local state ---------------------------------------------------------------
# Where the SSH key and generated database password are kept on this computer.
STATE_DIR=~/.familyhub-deploy

# ---- App settings (sent to the server; the APP_ prefix is removed) -------------
APP_SESSION_TTL_DAYS=30
APP_DEVICE_SESSION_TTL_DAYS=365
# Run background jobs (calendar sync, reminders) in the separate worker container.
APP_WORKER_MODE=off
APP_WEATHER_ENABLED=true
APP_EMAIL_FROM=FamilyHub <no-reply@familyhub.app>
# Photo storage: "local" (server disk) or "s3" (needs S3 permissions + bucket).
APP_STORAGE_DRIVER=local
APP_S3_BUCKET=
# Google / Microsoft calendar sync. Client IDs are public; secrets go in secrets.env.
APP_GOOGLE_CLIENT_ID=
APP_MICROSOFT_CLIENT_ID=
APP_MICROSOFT_TENANT=common

# --- WhatsApp notifications (Meta WhatsApp Cloud API) ---
# Phone number ID from developers.facebook.com -> your app -> WhatsApp -> API Setup (not the phone number).
# The access token goes in deploy/secrets.env as WHATSAPP_ACCESS_TOKEN.
APP_WHATSAPP_PHONE_NUMBER_ID=
# Approved template with two body variables ({{1}} title, {{2}} details). Empty = plain text,
# which only reaches people who messaged your WhatsApp number in the last 24 hours.
APP_WHATSAPP_TEMPLATE=
APP_WHATSAPP_TEMPLATE_LANG=en_US
