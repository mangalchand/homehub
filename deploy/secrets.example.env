# Copy to deploy/secrets.env and fill in what you use. Never commit secrets.env.
# Everything here is sent to the server's .env as-is.
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_SECRET=
# smtp://user:password@smtp.example.com:587 (for invitation and password-reset emails)
SMTP_URL=
# Permanent system-user token with whatsapp_business_messaging (see APP_WHATSAPP_* in familyhub.config)
WHATSAPP_ACCESS_TOKEN=
