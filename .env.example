# ── Core ──
NODE_ENV=development
API_PORT=4000
# Public URL of the web app (used for redirects, CORS, invitation links)
WEB_ORIGIN=http://localhost:5173
# Public URL of the API (used to build OAuth redirect URIs)
API_PUBLIC_URL=http://localhost:4000
DATABASE_URL=postgresql://familyhub:familyhub@localhost:5432/familyhub?schema=public
# 32-byte base64 key for AES-256-GCM encryption of tokens/secrets. Generate: openssl rand -base64 32
ENCRYPTION_KEY=
# Cookie settings: set COOKIE_SECURE=true behind HTTPS
COOKIE_SECURE=false
SESSION_TTL_DAYS=30
DEVICE_SESSION_TTL_DAYS=365

# ── Background worker (sync, reminders). "inline" runs inside the API process. ──
WORKER_MODE=inline

# ── Calendar providers (optional; features stay disabled until configured) ──
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT=common
# Allow the built-in demo provider (mock external calendars) — never enable in production
ENABLE_DEMO_PROVIDER=true

# ── Weather (Open-Meteo, no key required). Set to false to disable outbound weather calls. ──
WEATHER_ENABLED=true

# ── Email (optional). When unset, emails (invites/password reset) are logged to the API console in development. ──
SMTP_URL=
EMAIL_FROM="FamilyHub <no-reply@familyhub.local>"

# ── Web ──
VITE_API_URL=http://localhost:4000

# Family photos storage: local | s3
STORAGE_DRIVER=local
UPLOAD_DIR=./data/uploads
S3_BUCKET=
AWS_REGION=us-east-1
