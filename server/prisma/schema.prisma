generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model FamilyMember {
  id          String   @id @default(cuid())
  name        String
  role        String   @default("child")
  email       String?
  avatarColor String   @default("#6366f1")
  points      Int      @default(0)
  events      CalendarEvent[]
  chores      Chore[]
  expenses    Expense[]
  reminders   Reminder[]
}

model Invitation {
  id     String  @id @default(cuid())
  email  String
  role   String  @default("guardian")
  status String  @default("pending")
  sentAt DateTime @default(now())
}

model CalendarEvent {
  id        String        @id @default(cuid())
  title     String
  date      DateTime
  startTime String?
  endTime   String?
  category  String        @default("family")
  member    FamilyMember? @relation(fields: [memberId], references: [id])
  memberId  String?
}

model Chore {
  id         String        @id @default(cuid())
  title      String
  points     Int           @default(10)
  dueDate    DateTime
  completed  Boolean       @default(false)
  recurring  String        @default("none")
  assignee   FamilyMember? @relation(fields: [assigneeId], references: [id])
  assigneeId String?
}

model GroceryItem {
  id       String  @id @default(cuid())
  name     String
  quantity Int     @default(1)
  category String  @default("other")
  checked  Boolean @default(false)
}

model MaintenanceTask {
  id             String    @id @default(cuid())
  title          String
  area           String
  dueDate        DateTime
  lastDone       DateTime?
  intervalMonths Int?
  status         String    @default("upcoming")
  notes          String?
}

model Expense {
  id       String        @id @default(cuid())
  title    String
  amount   Float
  category String        @default("other")
  date     DateTime
  paidBy   FamilyMember? @relation(fields: [paidById], references: [id])
  paidById String?
}

model VaultDocument {
  id         String   @id @default(cuid())
  title      String
  category   String   @default("other")
  uploadedAt DateTime @default(now())
  sizeLabel  String   @default("—")
  expiresAt  DateTime?
}

model Reminder {
  id       String        @id @default(cuid())
  title    String
  dueAt    DateTime
  done     Boolean       @default(false)
  priority String        @default("medium")
  member   FamilyMember? @relation(fields: [memberId], references: [id])
  memberId String?
}
